NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Único e-mail autorizado a entrar no sistema
ALLOWED_EMAIL=voce@exemplo.com

# --- Integrações (só no servidor; nunca com prefixo NEXT_PUBLIC_) ---
# Endereço público do sistema, usado nos links do e-mail e do calendário
NEXT_PUBLIC_SITE_URL=https://gestao-may.vercel.app
# Chave de serviço do Supabase: usada só pelo cron e pelo feed iCal (rodam sem sessão)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Resend (envio do resumo diário)
RESEND_API_KEY=re_...
RESEND_FROM=Gestão <onboarding@resend.dev>
# Segredo do cron da Vercel (qualquer string longa aleatória)
CRON_SECRET=...
# Autentique (assinatura eletrônica) — token pessoal da conta
AUTENTIQUE_TOKEN=
# Segredo do webhook do Autentique (opcional, mas recomendado)
AUTENTIQUE_WEBHOOK_SECRET=
# InfinitePay: segredo que vai na URL do webhook (qualquer string longa aleatória)
INFINITEPAY_WEBHOOK_SECRET=
